import { Icon } from "astro-icon/components";
---

<div>
  <h3 class="text-2xl font-bold text-white mb-8">Experience & Education</h3>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
    <div
      class="p-6 sm:p-8 rounded-3xl bg-neutral-900/30 backdrop-blur-sm border border-white/10 hover:border-amber-400/30 transition-all duration-300 flex items-start gap-5 shadow-lg group hover:bg-white/5"
    >
      <div
        class="w-14 h-14 rounded-2xl bg-amber-400/10 border border-amber-400/30 flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:bg-amber-400/20 transition-all duration-300"
      >
        <Icon name="lucide:briefcase" class="w-7 h-7 text-amber-400" />
      </div>
      <div>
        <div
          class="inline-flex items-center gap-1.5 px-3 py-1 mb-3 rounded-full bg-amber-400/10 text-amber-400 text-[10px] font-bold uppercase tracking-widest border border-amber-400/20"
        >
          Current
        </div>
        <h4 class="text-xl font-bold text-white leading-tight mb-1">
          Junior Software Engineer
        </h4>
        <a
          href="https://slovensko.digital"
          target="_blank"
          class="font-medium text-amber-400 hover:text-amber-300 hover:underline underline-offset-4 transition-colors"
          >Slovensko.Digital</a
        >
        <p class="text-sm text-neutral-400 mt-2">Sep 2025 — Present</p>
      </div>
    </div>

    <div
      class="p-6 sm:p-8 rounded-3xl bg-neutral-900/30 backdrop-blur-sm border border-white/10 hover:border-amber-400/30 transition-all duration-300 flex items-start gap-5 shadow-lg group hover:bg-white/5"
    >
      <div
        class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:border-amber-400/30 transition-all duration-300"
      >
        <Icon
          name="lucide:graduation-cap"
          class="w-7 h-7 text-neutral-300 group-hover:text-amber-400"
        />
      </div>
      <div>
        <div
          class="inline-flex items-center gap-1.5 px-3 py-1 mb-3 rounded-full bg-white/5 text-neutral-400 text-[10px] font-bold uppercase tracking-widest border border-white/10"
        >
          Student
        </div>
        <h4 class="text-xl font-bold text-white leading-tight mb-1">
          General Studies
        </h4>
        <div class="font-medium text-neutral-300">
          Gymnázium Karola Štúra v Modre
        </div>
        <p class="text-sm text-neutral-400 mt-2">2020 — 2028</p>
      </div>
    </div>
  </div>
</div>
